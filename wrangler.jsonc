// Configuración para Cloudflare Workers (sitio estático, sin código de servidor).
// El "name" debe coincidir con el nombre del Worker conectado al repositorio en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nephei-pluto",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public"
  },
  "workers_dev": false,
  "routes": [
    { "pattern": "pluto.nephei.org", "custom_domain": true }
  ]
}
